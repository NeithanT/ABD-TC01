BASE_URI=http://localhost

# React
REACT_PORT=5173
REACT_INTERNAL_PORT=5173

# Express
BACKEND_PORT=3000
BACKEND_INTERNAL_PORT=3000

# Credenciales de la base de datos (PostgreSQL)
DB_HOST=database
POSTGRES_USER=tu_user
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_DB=name_de_tu_db
DB_PORT=5432
POSTGRE_INTERNAL_PORT=5432

#Credenciales de Keycloak
KEYCLOAK_ADMIN_USERNAME=tu_user
KEYCLOAK_ADMIN_PASSWORD=tu_password_seguro
KEYCLOAK_PORT=8080
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# Keycloak Config para React
VITE_CLIENT_ID=react
REALM_NAME="Sistema_Mirador"
VITE_AUTHORITY=http://localhost:8080/realms/master
